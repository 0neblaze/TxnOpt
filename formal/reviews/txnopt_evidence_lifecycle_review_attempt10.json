  "findings": [
    {
      "id": "F-04",
      "severity": "MAJOR",
      "path": "src/txnopt_evidence/reviewer.py",
      "line": 993,
      "title": "Interrupted or aborted native exact work can omit the native receipt",
      "counterexample": "_semantic_exact_work_started only returns true for candidate_transaction events whose phase is COMMITTED and whose started_work is positive (lines 993-1001). The native-receipt gate at lines 768-776 therefore runs only when that flag is true. A deadline/worker-failure path can have physical t4_waste_observation with positive discarded work but no committed started_work; the validator then accepts a native expected identity with no native_round_observation. The temporary adversarial probe returned ACCEPTED for this case, while the analogous committed case returned REJECTED.",
      "related_paths": [
        "src/txnopt/runtime.py:384-443",
        "src/txnopt_evidence/reviewer.py:264-291",
        "src/txnopt_evidence/reviewer.py:709-837",
        "src/txnopt_evidence/reviewer.py:993-1001"
      ],
      "impact": "A raw bundle with uncommitted native exact work can pass physical/T4 replay without a receipt binding its native source identity, so native exact-work evidence is not fail-closed for all work-bearing transaction outcomes. This blocks anchored-evidence PASS and Level 1 readiness.",
      "required_correction": "Define work-start detection over every work-bearing transaction outcome (including INTERRUPTED and ABORTED/T4-positive paths), require at least one matching native round receipt for native exact work, and add a full raw-bundle tamper test that removes that receipt and recomputes all temporary sidecars/lifecycle fields."
    }
  ],

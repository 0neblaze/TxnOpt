# Local literature shortcut (the files live in ~/Documents)
/document/

# Read-only reference repositories
/reference/

# Generated output and local scratch work. Active commands default to the
# tree-scoped XDG state/cache roots; repository-local results are legacy or
# unclassified data and never satisfy a formal evidence gate.
/results/
/outputs/
/scratch/
/tmp/

# Local databases and spill files
*.sqlite
*.sqlite3

# Local evolving research inputs (kept in the repository directory, not tracked)
/docs/roadmap/txnopt-research-strategy.local.md
/experiments/txnopt/case-catalog.local.json
/experiments/txnopt/runtime-calibration.local.json
# macOS AppleDouble metadata on non-APFS/external volumes
._*
**/._*
